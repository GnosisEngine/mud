{
  "name": "mud",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/GnosisEngine/mud.git"
  },
  "engines": {
    "node": ">= 10.12.0"
  },
  "license": "MIT",
  "scripts": {
    "login": "telnet localhost 4000",
    "login-raw": "stty raw -echo; nc localhost 4000; stty sane",
    "setup": "npm install && node util/setup.js",
    "dev": "node ./ranvier -v",
    "start": "node ./ranvier",
    "test": "NODE_ENV=test node --trace-warnings test/integration/run.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "npx tsc -p tsconfig.json --noEmit",
    "sync-local": "git diff --name-only HEAD | xargs -I{} sh -c 'test -f {} && mkdir -p ../mud-local/$(dirname {}) && cp {} ../mud-local/{} && echo \"synced: {}\"'",
    "sync-public": "rsync -rciL --filter=':- .gitignore' --exclude='INSTALL.md' --exclude='.git' ./ ../mud/",
    "compare-local": "rsync -rcniL --filter=':- .gitignore' --exclude='.git' ./ ../mud-local/",
    "compare-public": "rsync -rcniL --filter=':- .gitignore' --exclude='.git' ./ ../mud/",
    "security": "fail2ban-client status sshd",
    "service-restart": "systemctl restart mud",
    "update": "git pull origin master && systemctl restart mud",
    "follow-logs": "journalctl -u mud.service -f",
    "service-status": "systemctl status mud",
    "service-stop": "systemctl stop mud",
    "service-start": "systemctl start mud",
    "logs-today": "journalctl -u mud.service --since today",
    "logs-errors": "journalctl -u mud.service -p err --since today",
    "who": "ss -tnp | grep 4000",
    "connections": "ss -tn state established '( dport = :4000 or sport = :4000 )' | wc -l",
    "banned": "fail2ban-client status sshd | grep 'Banned IP'",
    "unban": "fail2ban-client set sshd unbanip",
    "disk": "du -sh data/ && df -h .",
    "players-all": "ls -1 data/players/ | sed 's/\\.json$//'",
    "players-count": "ls data/players/*.json 2>/dev/null | wc -l"
  },
  "dependencies": {
    "commander": "^2.19.0",
    "optimist": "",
    "ranvier": "^3.0.5",
    "ranvier-datasource-file": "^1.0.3",
    "semver": "^5.6.0",
    "sprintf-js": "^1.0.3",
    "sql.js": "^1.14.1",
    "sty": "",
    "uuid": "^3.3.2",
    "winston": "^2.4.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "eslint": "^8.57.1",
    "eslint-plugin-jsdoc": "^61.7.1",
    "git-url-parse": "^11.1.2",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "bundles/*"
  ]
}
